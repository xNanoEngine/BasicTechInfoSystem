---
interface Props {
  title: string;
}

const { title } = Astro.props;
import { Toaster } from "@/components/ui/sonner"
import '@/styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Admin Panel" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Admin Panel</title>
  </head>
  <body class="bg-slate-900 text-white min-h-screen flex flex-col">
    <nav class="bg-slate-800 border-b border-slate-700 p-4">
      <div class="container mx-auto flex justify-between items-center">
        <a href="/admin/dashboard" class="text-xl font-bold text-blue-500">TechInfo Admin</a>
        <div class="flex gap-4">
          <a href="/" class="hover:text-blue-400">Ver Sitio</a>
          <button id="logoutBtn" class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded text-sm transition-colors">
            Cerrar Sesión
          </button>
        </div>
      </div>
    </nav>

    <main class="flex-1 container mx-auto p-4">
      <slot />
    </main>

    <script>
      const logoutBtn = document.getElementById('logoutBtn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          try {
            const response = await fetch('http://localhost:3000/auth/logout', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
            });
            if (response.ok) {
              window.location.href = '/admin';
            }
          } catch (error) {
            console.error('Logout failed', error);
          }
        });
      }
    </script>
    <Toaster client:idle />
  </body>
</html>
