---
import MainLayout from '@/layouts/Layout.astro';
import { ProductCard } from '@/components/products/ProductCard';
import { slugify } from '@/lib/utils';
import type { SearchResponse, SearchResultItem } from '@/components/search/hook/interfaces/search';

export const prerender = false;

const { category } = Astro.params;
const page = Number(Astro.url.searchParams.get('page')) || 1;
const query = Astro.url.searchParams.get('q') || '';
const limit = 12;

const validCategories = ['cpu', 'gpu', 'motherboard', 'ram', 'psu', 'storage'];

if (!category || !validCategories.includes(category)) {
  return Astro.redirect('/404');
}

let products: SearchResultItem[] = [];
let metadata = {
  totalResults: 0,
  currentPage: 1,
  perPage: limit,
  totalPages: 0,
};

try {
  const response = await fetch(`http://localhost:3000/${category}?page=${page}&limit=${limit}&query=${query}`);
  if (response.ok) {
    const data = (await response.json()) as SearchResponse;
    products = data.data;
    metadata = data.metadata;
  }
} catch (error) {
  console.error(`Error fetching ${category}:`, error);
}

const categoryTitles: Record<string, string> = {
  cpu: 'Procesadores',
  gpu: 'Tarjetas de Video',
  motherboard: 'Placas Madre',
  ram: 'Memorias RAM',
  psu: 'Fuentes de Poder',
  storage: 'Almacenamiento',
};

const title = categoryTitles[category] || category;
---

<MainLayout title={title}>
  <div class="container mx-auto px-4 py-8 max-w-screen-2xl">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
            <p class="text-muted-foreground mt-1">Explora nuestra selección de {title.toLowerCase()}.</p>
        </div>
        
        <div class="w-full md:w-auto">
            <form method="get" action={`/${category}`} class="flex gap-2">
                <input 
                    type="text" 
                    name="q" 
                    placeholder={`Buscar en ${title}...`} 
                    value={query}
                    class="flex h-10 w-full md:w-[300px] rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                />
                <button type="submit" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                    Buscar
                </button>
            </form>
        </div>
    </div>
    
    {products.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {products.map((product) => (
            <ProductCard
            client:visible
            title={product.name}
            category={category}
            href={`/producto/${product.type}/${product.id}-${slugify(product.name)}`}
            price={`$${product.price}`}
            image={product.imageUrl || '/placeholder.png'}
            />
        ))}
        </div>
    ) : (
        <div class="text-center py-20">
            <h2 class="text-xl font-semibold">No se encontraron productos</h2>
            <p class="text-muted-foreground">Intenta más tarde.</p>
        </div>
    )}

    {/* Pagination */}
    {metadata.totalPages > 1 && (
        <div class="flex justify-center mt-12 gap-2">
        {metadata.currentPage > 1 && (
            <a href={`/${category}?page=${metadata.currentPage - 1}`} class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
            Anterior
            </a>
        )}
        <span class="flex items-center px-4 text-sm font-medium">
            Página {metadata.currentPage} de {metadata.totalPages}
        </span>
        {metadata.currentPage < metadata.totalPages && (
            <a href={`/${category}?page=${metadata.currentPage + 1}`} class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
            Siguiente
            </a>
        )}
        </div>
    )}
  </div>
</MainLayout>
