---
import MainLayout from '@/layouts/Layout.astro';
import { HeroSearch } from '@/components/products/HeroSearch';
import { ProductCard } from '@/components/products/ProductCard';

let latestProducts = [];
try {
  const response = await fetch('http://localhost:3000/search?sort=latest&limit=4');
  const data = await response.json();
  latestProducts = data.data || [];
} catch (error) {
  console.error('Error fetching latest products:', error);
} 
---

<MainLayout title="Inicio">
    <section class="relative py-24 z-10">
        
        <div class="absolute inset-0 -z-10 h-full w-full bg-background overflow-hidden">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-size-[24px_24px]"></div>
            <div class="absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-primary/20 opacity-20 blur-[100px]"></div>
        </div>

        <div class="container mx-auto px-4 max-w-screen-2xl text-center relative">
            <h1 class="text-4xl md:text-7xl font-extrabold tracking-tight mb-6 text-foreground">
                Encuentra el <span class="text-primary">Hardware Perfecto</span>
            </h1>
            
            <p class="text-xl md:text-2xl text-muted-foreground mb-12 max-w-3xl mx-auto">
                Compara especificaciones, precios y rendimiento de miles de componentes de PC en segundos.
            </p>

            <div class="flex justify-center w-full">
                 <div class="w-full max-w-3xl"> 
                    <HeroSearch client:load />
                 </div>
            </div>
        </div>
    </section>

    <section class="relative z-0 py-16 bg-muted/30">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight">Últimos Lanzamientos</h2>
                    <p class="text-muted-foreground mt-1">Lo más nuevo en el mercado de hardware.</p>
                </div>
                <a href="/catalogo" class="text-sm font-medium text-indigo-600 hover:text-indigo-500 hover:underline">
                    Ver todo &rarr;
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {latestProducts.map((product) => (
                    <ProductCard
                        client:visible
                        title={product.name}
                        category={product.category}
                        price={`$${product.price}`}
                        image={product.imageUrl || '/placeholder.png'}
                        isNew={true}
                    />
                ))}
            </div>
        </div>
    </section>
</MainLayout>