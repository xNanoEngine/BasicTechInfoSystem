---
// src/pages/producto/[type]/[slug].astro
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Card, CardContent } from '@/components/ui/card';
import { productService } from '@/services/product.service';
// IMPORTAMOS LA NUEVA CONFIGURACIÓN
import { productSpecsConfig, formatValue } from '@/config/product-specs';
import { slugify } from '@/lib/utils'; // Asegúrate de tener esto o usa un simple replace

const { type, slug } = Astro.params;

// 1. Extraer ID del slug (ej: "15-rtx-4090" -> "15")
const id = slug?.split('-')[0];

if (!type || !id) return Astro.redirect('/404');

// 2. Obtener producto
const product = await productService.getProductDetail(type, id);

if (!product) return Astro.redirect('/404');

// 3. OBTENER LA CONFIGURACIÓN CORRECTA SEGÚN EL TIPO
// Si el tipo es 'gpu', traemos las reglas de GPU. Si no existe configuración, usamos array vacío.
const specDefinitions = productSpecsConfig[type] || [];

// Formateadores visuales
const formatPrice = (price: number) => new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP' }).format(price);

// Diccionario para el título de la categoría
const categoryLabels: Record<string, string> = {
    gpu: 'Tarjeta de Video',
    cpu: 'Procesador',
    ram: 'Memoria RAM',
    psu: 'Fuente de Poder',
    motherboard: 'Placa Madre',
    storage: 'Almacenamiento'
};
---

<Layout title={`${product.name} | TechCompare`}>
    <div class="container max-w-screen-2xl mx-auto px-4 py-10">
        
        {/* BREADCRUMB */}
       <nav class="...">
    <a href="/" ...>Inicio</a>
    <span>/</span>
    
    <a href={`/buscar?category=${type}`} class="hover:text-primary transition-colors">
        {categoryLabels[type] || type}
    </a>
    
    <span>/</span>
    <span>{product.name}</span>
</nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            {/* IMAGEN DEL PRODUCTO */}
            <div class="lg:col-span-5">
                <div class="sticky top-24">
                    <div class="border rounded-2xl bg-white dark:bg-zinc-100 p-8 flex items-center justify-center aspect-square shadow-sm overflow-hidden relative group">
                         {/* Badge de "Nuevo" o "Oferta" si quisieras ponerlo aquí */}
                        <img 
                            src={product.imageUrl || "/placeholder.png"} 
                            alt={product.name}
                            class="w-full h-full object-contain hover:scale-110 transition-transform duration-500"
                        />
                    </div>
                </div>
            </div>

            {/* INFORMACIÓN Y ESPECIFICACIONES */}
            <div class="lg:col-span-7 space-y-8">
                
                {/* Cabecera */}
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <Badge variant="secondary" className="text-sm px-3 py-1 uppercase tracking-wide">
                            {product.manufacturer}
                        </Badge>
                        <Badge variant="outline" className="text-sm px-3 py-1 uppercase tracking-wide text-muted-foreground">
                            {categoryLabels[type] || type}
                        </Badge>
                    </div>
                    
                    <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-foreground leading-tight mb-6">
                        {product.name}
                    </h1>

                    <div class="flex flex-col sm:flex-row sm:items-end gap-6 pb-8 border-b border-border">
                        <div>
                            <p class="text-sm text-muted-foreground font-medium mb-1">Precio aproximado</p>
                            <span class="text-4xl font-bold text-primary block">
                                {formatPrice(product.price)}
                            </span>
                        </div>
                        
                        <div class="flex gap-3 sm:ml-auto w-full sm:w-auto">
                            <Button size="lg" className="flex-1 sm:flex-none cursor-pointer gap-2 h-12 text-base shadow-lg shadow-primary/20">
                                <span>⚖️</span> Añadir a Comparar
                            </Button>
                        </div>
                    </div>
                </div>

                {/* TABLA DE SPECS (Renderizada con nuestro Config) */}
                <div>
                    <h3 class="text-xl font-bold mb-5 flex items-center gap-2">
                        <span class="bg-primary/10 text-primary p-2 rounded-lg text-sm">⚙️</span>
                        Especificaciones Técnicas
                    </h3>
                    
                    {specDefinitions.length > 0 ? (
                        <Card className="overflow-hidden border-muted">
                            <CardContent className="p-0">
                                <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:gap-px bg-muted/50">
                                    {specDefinitions.map((spec) => {
                                        // Extraemos el valor real usando la llave (ej: product['baseClock'])
                                        const rawValue = product[spec.key];
                                        // Lo formateamos (ej: "3.5 GHz")
                                        const displayValue = formatValue(rawValue, spec);

                                        return (
                                            <div class="flex flex-col p-4 bg-card hover:bg-muted/30 transition-colors">
                                                <dt class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">
                                                    {spec.label}
                                                </dt>
                                                <dd class="text-base font-semibold text-foreground">
                                                    {displayValue}
                                                </dd>
                                            </div>
                                        );
                                    })}
                                </div>
                            </CardContent>
                        </Card>
                    ) : (
                        <p class="text-muted-foreground italic">
                            No hay especificaciones detalladas disponibles para este componente.
                        </p>
                    )}
                </div>

            </div>
        </div>
    </div>
</Layout>