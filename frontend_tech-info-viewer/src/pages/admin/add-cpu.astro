---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CpuForm } from '@/components/admin/CpuForm';
---

<AdminLayout title="Agregar CPU">
  <div class="max-w-4xl mx-auto py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Gestión de Procesadores</h1>
      <p class="text-slate-400">Agrega nuevos procesadores al catálogo del sistema.</p>
    </div>
    
    <CpuForm client:load />
  </div>
</AdminLayout>
