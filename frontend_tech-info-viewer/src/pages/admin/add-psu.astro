---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { PsuForm } from '@/components/admin/PsuForm';
---

<AdminLayout title="Agregar PSU">
  <div class="max-w-4xl mx-auto py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Gestión de Fuentes de Poder</h1>
      <p class="text-slate-400">Agrega nuevas fuentes de poder al catálogo del sistema.</p>
    </div>
    
    <PsuForm client:load />
  </div>
</AdminLayout>
