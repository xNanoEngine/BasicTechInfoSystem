---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { RamForm } from '@/components/admin/RamForm';
---

<AdminLayout title="Agregar RAM">
  <div class="max-w-4xl mx-auto py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Gestión de Memorias RAM</h1>
      <p class="text-slate-400">Agrega nuevas memorias RAM al catálogo del sistema.</p>
    </div>
    
    <RamForm client:load />
  </div>
</AdminLayout>
