---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { StorageForm } from '@/components/admin/StorageForm';
---

<AdminLayout title="Agregar Almacenamiento">
  <div class="max-w-4xl mx-auto py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Gestión de Almacenamiento</h1>
      <p class="text-slate-400">Agrega nuevos dispositivos de almacenamiento al catálogo del sistema.</p>
    </div>
    
    <StorageForm client:load />
  </div>
</AdminLayout>
